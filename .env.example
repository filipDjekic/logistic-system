# Copy this file to .env before starting the Docker development stack.
DB_NAME=Logistics
DB_USERNAME=sa
# Required: use at least 8 characters from at least 3 character classes.
DB_PASSWORD=

# Required: use a long random development secret (at least 32 bytes).
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

DB_PORT=1433
BACKEND_PORT=8080
FRONTEND_PORT=5173

VITE_APP_NAME=Logistics management system
# Keep true for reliable file watching with Docker Desktop on Windows.
CHOKIDAR_USEPOLLING=true
